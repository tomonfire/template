# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,rs,java,kt,cs}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Markdown list/code indentation is content, not style
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
